# Server-only. Never prefix with NEXT_PUBLIC_ - this must not reach the browser bundle.
# Base URL of the API Gateway that this portal proxies /api/v1/* requests to.
GATEWAY_URL=http://localhost:8080

# OIDC (Keycloak). See docs/security/NEXTJS_BFF_AUTHENTICATION.md and
# docs/security/KEYCLOAK_LOCAL_DEVELOPMENT.md. Defaults below (in lib/auth/config.ts) match local
# development exactly - production MUST override every one of these with real values.
# KEYCLOAK_ISSUER=http://localhost:8180/realms/gdb
# KEYCLOAK_CLIENT_ID=gdb-employee-portal
# KEYCLOAK_CLIENT_SECRET=                      # never commit a real value here
# REDIS_URL=redis://localhost:6379
